NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo para los scripts de scripts/ (crear admin, migrar assets demo).
# Salta RLS por completo: nunca la expongas con NEXT_PUBLIC_ ni la subas al repo.
SUPABASE_SERVICE_ROLE_KEY=

# Número de WhatsApp de la tienda para el checkout (formato internacional, solo dígitos, sin +)
# Ejemplo: 573001234567
NEXT_PUBLIC_STORE_WHATSAPP_NUMBER=

# Orígenes autorizados para embeber /admin, separados por coma.
# Usa el dominio white-label de Órbita IA desde el que se abrirá el panel.
ORBITA_ALLOWED_FRAME_ANCESTORS=https://TU-DOMINIO-WHITELABEL
# Ponlo en true cuando el dominio propio ya funcione: deja de autorizar los
# dominios base del proveedor del CRM en la cabecera Content-Security-Policy.
ORBITA_STRICT_FRAME_ANCESTORS=false

# CRM de Órbita IA (solo servidor). Usa un Private Integration Token de la subcuenta.
# Scopes requeridos: contacts.write, conversations/message.write,
# opportunities.readonly y opportunities.write.
ORBITA_CRM_API_KEY=
ORBITA_CRM_LOCATION_ID=
# Código que se antepone a teléfonos nacionales de 10 dígitos.
ORBITA_CRM_DEFAULT_PHONE_COUNTRY_CODE=57
ORBITA_CRM_CONTACT_COUNTRY=CO
# Opcional: guarda la cédula en un custom field además de la nota del pedido.
ORBITA_CRM_CEDULA_CUSTOM_FIELD_ID=
# Canal por el que sale la cotización.
#   Custom -> proveedor externo de SMS; exige ORBITA_CRM_CONVERSATION_PROVIDER_ID.
#   SMS    -> usa el proveedor marcado como predeterminado en la subcuenta
#             (Settings > Phone Numbers > Advanced Settings > SMS Provider);
#             en ese caso el id del proveedor no hace falta.
# El número remitente siempre lo decide el proveedor, no esta aplicación.
ORBITA_CRM_MESSAGE_TYPE=Custom
ORBITA_CRM_CONVERSATION_PROVIDER_ID=

# Cloudflare R2 (almacenamiento de imágenes) — solo server-side, nunca exponer con NEXT_PUBLIC_
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# URL pública base del bucket, sin slash final. NO es el endpoint S3
# (https://<account>.r2.cloudflarestorage.com): ese exige peticiones firmadas y el
# navegador recibiría 401. Actívala en Cloudflare > R2 > tu bucket > Settings >
# Public Development URL (https://pub-xxxxxxxx.r2.dev) o conecta un dominio propio.
# next.config.ts autoriza este host en images.remotePatterns, así que debe estar
# definida también en el entorno de build (Vercel) o next/image bloqueará las imágenes.
R2_PUBLIC_URL=
