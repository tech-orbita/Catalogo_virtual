NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo para los scripts de scripts/ (crear admin, migrar assets demo).
# Salta RLS por completo: nunca la expongas con NEXT_PUBLIC_ ni la subas al repo.
SUPABASE_SERVICE_ROLE_KEY=

# Número de WhatsApp de la tienda para el checkout (formato internacional, solo dígitos, sin +)
# Ejemplo: 573001234567
NEXT_PUBLIC_STORE_WHATSAPP_NUMBER=

# Orígenes autorizados para embeber /admin, separados por coma.
# Usa el dominio white-label de Órbita IA desde el que se abrirá el panel.
ORBITA_ALLOWED_FRAME_ANCESTORS=https://TU-DOMINIO-WHITELABEL
# Ponlo en true cuando el dominio propio ya funcione: deja de autorizar los
# dominios base del proveedor del CRM en la cabecera Content-Security-Policy.
ORBITA_STRICT_FRAME_ANCESTORS=false

# CRM de Órbita IA (solo servidor). Usa un Private Integration Token de la subcuenta.
# Scopes requeridos: contacts.write, opportunities.readonly y
# opportunities.write.
ORBITA_CRM_API_KEY=
ORBITA_CRM_LOCATION_ID=
# Código que se antepone a teléfonos nacionales de 10 dígitos.
ORBITA_CRM_DEFAULT_PHONE_COUNTRY_CODE=57
ORBITA_CRM_CONTACT_COUNTRY=CO
# Workflow inicial: envía botones y conserva la espera de APROBAR/RECHAZAR.
ORBITA_CRM_QUOTE_WORKFLOW_ID=f60ba650-14ca-451d-87c4-6b3ab6eeb311
# Workflow corto: envía la cotización corregida y termina inmediatamente.
ORBITA_CRM_QUOTE_RESEND_WORKFLOW_ID=ae18a7df-b54e-4e0c-998b-b713d661a762
# Enlaces firmados que asocian una visita desde WhatsApp con su contacto de GHL.
# Usa dos secretos distintos y aleatorios de al menos 32 caracteres.
ORBITA_CATALOG_LINK_SIGNING_SECRET=
ORBITA_CATALOG_LINK_API_SECRET=
# Dominio público del catálogo, sin ruta final. Ejemplo: https://catalogo.example.com
ORBITA_PUBLIC_CATALOG_URL=
# Los IDs existentes conservan valores compatibles en src/lib/crm.ts; el ID del
# workflow de reenvío se configura por entorno. El workflow decide el proveedor
# y el número remitente; la app no crea mensajes directamente.

# Contacto operativo al que se enrutan automáticamente los domicilios.
ORBITA_LOGISTICS_WHATSAPP_NUMBER=3508811341
# ID del contacto de Órbita que representa el grupo de WhatsApp de domicilios.
# Al marcar una cotización aceptada se le activa el workflow de notificación de
# pedidos con el mismo formato de mensaje. Opcional: el código trae el valor actual.
ORBITA_ORDERS_GROUP_CONTACT_ID=72jZuNAuZrzHccn5JWir
# Workflow que solo tiene la acción "Send WhatsApp Group Message" con
# {{contact.notificacion_nuevo_pedido}}. Debe permitir reingreso.
ORBITA_CRM_ORDERS_GROUP_WORKFLOW_ID=a659c673-0886-4527-bc8e-f958de361e4a
# Secreto del webhook POST /api/integrations/quote-response (header
# x-orbita-webhook-secret). Mínimo 32 caracteres; su hash SHA-256 se guarda en
# private.integration_secrets con name = 'quote_webhook'.
ORBITA_QUOTE_WEBHOOK_SECRET=

# Cloudflare R2 (almacenamiento de imágenes) — solo server-side, nunca exponer con NEXT_PUBLIC_
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# URL pública base del bucket, sin slash final. NO es el endpoint S3
# (https://<account>.r2.cloudflarestorage.com): ese exige peticiones firmadas y el
# navegador recibiría 401. Actívala en Cloudflare > R2 > tu bucket > Settings >
# Public Development URL (https://pub-xxxxxxxx.r2.dev) o conecta un dominio propio.
# next.config.ts autoriza este host en images.remotePatterns, así que debe estar
# definida también en el entorno de build (Vercel) o next/image bloqueará las imágenes.
R2_PUBLIC_URL=
